# Copier ce fichier en ".env" à la racine avant de lancer docker compose.

# Clé de signature des tokens JWT — à changer impérativement en production.
SECRET_KEY=change-me-in-production

# Hôtes autorisés au scan, séparés par des virgules. Par défaut : uniquement
# le demo-target fourni + localhost, pour un usage strictement pédagogique.
ALLOWED_SCAN_HOSTS=demo-target,localhost,127.0.0.1
